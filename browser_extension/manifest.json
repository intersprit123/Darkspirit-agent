{
  "manifest_version": 3,
  "name": "Darkspirit Agent — Browser AI",
  "version": "0.2.0",
  "description": "Connect ChatGPT or Gemini to the local Darkspirit bridge and read AI replies aloud with your browser's default voice.",
  "permissions": [
    "storage",
    "tts"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Darkspirit Agent Browser AI"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
